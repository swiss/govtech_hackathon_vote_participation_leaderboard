    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?date\n (MAX(IF(?regionCode = \"1\", ?participation, 0)) AS ?ZH)\n  (MAX(IF(?regionCode = \"2\", ?participation, 0)) AS ?BE)\n  (MAX(IF(?regionCode = \"3\", ?participation, 0)) AS ?LU)\n  (MAX(IF(?regionCode = \"4\", ?participation, 0)) AS ?UR)\n  (MAX(IF(?regionCode = \"5\", ?participation, 0)) AS ?SZ)\n  (MAX(IF(?regionCode = \"6\", ?participation, 0)) AS ?OW)\n  (MAX(IF(?regionCode = \"7\", ?participation, 0)) AS ?NW)\n  (MAX(IF(?regionCode = \"8\", ?participation, 0)) AS ?GL)\n  (MAX(IF(?regionCode = \"9\", ?participation, 0)) AS ?ZG)\n  (MAX(IF(?regionCode = \"10\", ?participation, 0)) AS ?FR)\n  (MAX(IF(?regionCode = \"11\", ?participation, 0)) AS ?SO)\n  (MAX(IF(?regionCode = \"12\", ?participation, 0)) AS ?BS)\n  (MAX(IF(?regionCode = \"13\", ?participation, 0)) AS ?BL)\n  (MAX(IF(?regionCode = \"14\", ?participation, 0)) AS ?SH)\n  (MAX(IF(?regionCode = \"15\", ?participation, 0)) AS ?AR)\n  (MAX(IF(?regionCode = \"16\", ?participation, 0)) AS ?AI)\n  (MAX(IF(?regionCode = \"17\", ?participation, 0)) AS ?SG)\n  (MAX(IF(?regionCode = \"18\", ?participation, 0)) AS ?GR)\n  (MAX(IF(?regionCode = \"19\", ?participation, 0)) AS ?AG)\n  (MAX(IF(?regionCode = \"20\", ?participation, 0)) AS ?TG)\n  (MAX(IF(?regionCode = \"21\", ?participation, 0)) AS ?TI)\n  (MAX(IF(?regionCode = \"22\", ?participation, 0)) AS ?VD)\n  (MAX(IF(?regionCode = \"23\", ?participation, 0)) AS ?VS)\n  (MAX(IF(?regionCode = \"24\", ?participation, 0)) AS ?NE)\n  (MAX(IF(?regionCode = \"25\", ?participation, 0)) AS ?GE)\n  (MAX(IF(?regionCode = \"26\", ?participation, 0)) AS ?JU)\nWHERE {\n  <https://politics.ld.admin.ch/political-rights/popular-vote/1> <https://cube.link/observationSet> ?observationSet0 .\n  ?observationSet0 <https://cube.link/observation> ?votation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/region> ?region .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/stimmbeteiligung> ?participation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/date> ?date .\n\n  FILTER(STRSTARTS(STR(?region), \"https://ld.admin.ch/canton/\"))\n  BIND(UCASE(REPLACE(STR(?region), \"^https://ld.admin.ch/canton/\", \"\")) AS ?regionCode)\n}\n\nGROUP BY ?date\nORDER BY DESC(?date)\nLIMIT 100",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?date ?region (AVG(?participation) AS ?participation) WHERE {\n  <https://politics.ld.admin.ch/political-rights/popular-vote/1> <https://cube.link/observationSet> ?observationSet0 .\n  ?observationSet0 <https://cube.link/observation> ?votation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/region> ?region .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/stimmbeteiligung> ?participation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/date> ?date .\n\n  FILTER(STRSTARTS(STR(?region), \"https://ld.admin.ch/canton/\"))\n}\nGROUP BY ?date ?region\nORDER BY DESC(?date) ?region\nLIMIT 100",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?date ?region ?participation ?rank\nWHERE {\n  {\n    SELECT ?date ?region (AVG(?p) AS ?participation)\n    WHERE {\n      <https://politics.ld.admin.ch/political-rights/popular-vote/1> <https://cube.link/observationSet> ?observationSet0 .\n      ?observationSet0 <https://cube.link/observation> ?votation .\n      ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/region> ?region .\n      ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/stimmbeteiligung> ?p .\n      ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/date> ?date .\n\n      FILTER(STRSTARTS(STR(?region), \"https://ld.admin.ch/canton/\"))\n    }\n    GROUP BY ?date ?region\n  }\n\n  FILTER NOT EXISTS {\n    {\n      SELECT ?date ?region2 (AVG(?p2) AS ?participation2)\n      WHERE {\n        <https://politics.ld.admin.ch/political-rights/popular-vote/1> <https://cube.link/observationSet> ?observationSet1 .\n        ?observationSet1 <https://cube.link/observation> ?votation2 .\n        ?votation2 <https://politics.ld.admin.ch/political-rights/popular-vote/region> ?region2 .\n        ?votation2 <https://politics.ld.admin.ch/political-rights/popular-vote/stimmbeteiligung> ?p2 .\n        ?votation2 <https://politics.ld.admin.ch/political-rights/popular-vote/date> ?date .\n\n        FILTER(STRSTARTS(STR(?region2), \"https://ld.admin.ch/canton/\"))\n      }\n      GROUP BY ?date ?region2\n    }\n\n    FILTER(?participation2 > ?participation)\n  }\n\n  BIND(1 AS ?rank)\n}\nORDER BY DESC(?date) ?region\nLIMIT 100",
    "metadata": {}
  }
]