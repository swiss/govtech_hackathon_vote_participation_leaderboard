[
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?date\n (MAX(IF(?regionCode = \"1\", ?participation, 0)) AS ?ZH)\n  (MAX(IF(?regionCode = \"2\", ?participation, 0)) AS ?BE)\n  (MAX(IF(?regionCode = \"3\", ?participation, 0)) AS ?LU)\n  (MAX(IF(?regionCode = \"4\", ?participation, 0)) AS ?UR)\n  (MAX(IF(?regionCode = \"5\", ?participation, 0)) AS ?SZ)\n  (MAX(IF(?regionCode = \"6\", ?participation, 0)) AS ?OW)\n  (MAX(IF(?regionCode = \"7\", ?participation, 0)) AS ?NW)\n  (MAX(IF(?regionCode = \"8\", ?participation, 0)) AS ?GL)\n  (MAX(IF(?regionCode = \"9\", ?participation, 0)) AS ?ZG)\n  (MAX(IF(?regionCode = \"10\", ?participation, 0)) AS ?FR)\n  (MAX(IF(?regionCode = \"11\", ?participation, 0)) AS ?SO)\n  (MAX(IF(?regionCode = \"12\", ?participation, 0)) AS ?BS)\n  (MAX(IF(?regionCode = \"13\", ?participation, 0)) AS ?BL)\n  (MAX(IF(?regionCode = \"14\", ?participation, 0)) AS ?SH)\n  (MAX(IF(?regionCode = \"15\", ?participation, 0)) AS ?AR)\n  (MAX(IF(?regionCode = \"16\", ?participation, 0)) AS ?AI)\n  (MAX(IF(?regionCode = \"17\", ?participation, 0)) AS ?SG)\n  (MAX(IF(?regionCode = \"18\", ?participation, 0)) AS ?GR)\n  (MAX(IF(?regionCode = \"19\", ?participation, 0)) AS ?AG)\n  (MAX(IF(?regionCode = \"20\", ?participation, 0)) AS ?TG)\n  (MAX(IF(?regionCode = \"21\", ?participation, 0)) AS ?TI)\n  (MAX(IF(?regionCode = \"22\", ?participation, 0)) AS ?VD)\n  (MAX(IF(?regionCode = \"23\", ?participation, 0)) AS ?VS)\n  (MAX(IF(?regionCode = \"24\", ?participation, 0)) AS ?NE)\n  (MAX(IF(?regionCode = \"25\", ?participation, 0)) AS ?GE)\n  (MAX(IF(?regionCode = \"26\", ?participation, 0)) AS ?JU)\nWHERE {\n  <https://politics.ld.admin.ch/political-rights/popular-vote/1> <https://cube.link/observationSet> ?observationSet0 .\n  ?observationSet0 <https://cube.link/observation> ?votation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/region> ?region .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/stimmbeteiligung> ?participation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/date> ?date .\n\n  FILTER(STRSTARTS(STR(?region), \"https://ld.admin.ch/canton/\"))\n  BIND(UCASE(REPLACE(STR(?region), \"^https://ld.admin.ch/canton/\", \"\")) AS ?regionCode)\n}\n\nGROUP BY ?date\nORDER BY DESC(?date)\nLIMIT 20",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?date ?cantonAbrv ?actor (AVG(?participation) AS ?participation) WHERE \n{\n  <https://politics.ld.admin.ch/political-rights/popular-vote/1> <https://cube.link/observationSet> ?observationSet0 .\n  ?observationSet0 <https://cube.link/observation> ?votation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/region> ?region .\n  ?region a <https://schema.ld.admin.ch/Canton> .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/stimmbeteiligung> ?participation .\n  ?votation <https://politics.ld.admin.ch/political-rights/popular-vote/date> ?date .\n  ?region <http://schema.org/alternateName> ?cantonAbrv .\n\n  OPTIONAL {\n    <https://politics.ld.admin.ch/fc/cube-councillor> <https://cube.link/observationSet> ?observationSet1 .\n    ?observationSet1 <https://cube.link/observation> ?councillorSource .\n    ?councillorSource <http://schema.org/actor> ?actor .\n    ?councillorSource <http://schema.org/addressRegion> ?region .\n    ?councillorSource <http://schema.org/startDate> ?startDate .\n    OPTIONAL { ?councillorSource <http://schema.org/endDate> ?endDate . }\n    FILTER (?startDate <= ?date && (!BOUND(?endDate) || ?endDate >= ?date))\n    }\n  }\n\nGROUP BY ?date ?cantonAbrv ?actor\nORDER BY DESC(?date) ?cantonAbrv\nLIMIT 30",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "#pragma describe.strategy cbd\n#pragma join.hash off\nSELECT * WHERE {\n  <https://politics.ld.admin.ch/fc/cube-councillor> <https://cube.link/observationSet> ?observationSet0 .\n  ?observationSet0 <https://cube.link/observation> ?source0 .\n\n  ?source0 <http://schema.org/actor> ?actor .\n  ?actor <http://schema.org/name> ?actorName .\n  ?source0 <http://schema.org/addressRegion> ?addressRegion .\n  ?source0 <http://schema.org/startDate> ?startDate .\n  ?source0 <http://schema.org/endDate> ?endDate .\n  ?source0 <http://schema.org/gender> ?gender .\n  \n}",
    "metadata": {}
  }
